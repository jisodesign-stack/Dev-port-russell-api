<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/dashboard">Tableau de bord</a></li>
            <li class="breadcrumb-item"><a href="/catways">Catways</a></li>
            <li class="breadcrumb-item active">Nouveau catway</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-plus-circle"></i> Créer un nouveau catway
                </div>
                <div class="card-body">
                    <form action="/catways" method="POST">
                        <div class="mb-3">
                            <label for="catwayNumber" class="form-label">Numéro du catway *</label>
                            <input type="number" class="form-control" id="catwayNumber" name="catwayNumber" 
                                   min="1" required>
                            <div class="form-text">Numéro unique identifiant le catway</div>
                        </div>

                        <div class="mb-3">
                            <label for="catwayType" class="form-label">Type de catway *</label>
                            <select class="form-select" id="catwayType" name="catwayType" required>
                                <option value="">Sélectionnez un type</option>
                                <option value="short">Short (petit appontement)</option>
                                <option value="long">Long (grand appontement)</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label for="catwayState" class="form-label">État du catway</label>
                            <textarea class="form-control" id="catwayState" name="catwayState" 
                                      rows="3" placeholder="bon état">bon état</textarea>
                            <div class="form-text">Description de l'état actuel du catway</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Créer le catway
                            </button>
                            <a href="/catways" class="btn btn-secondary">
                                <i class="bi bi-x-lg"></i> Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
