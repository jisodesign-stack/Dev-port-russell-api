<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/dashboard">Tableau de bord</a></li>
            <li class="breadcrumb-item"><a href="/catways">Catways</a></li>
            <li class="breadcrumb-item"><a href="/catways/<%= catway.catwayNumber %>">Catway #<%= catway.catwayNumber %></a></li>
            <li class="breadcrumb-item active">Modifier</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-pencil"></i> Modifier le Catway #<%= catway.catwayNumber %>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <strong>Note :</strong> Seul l'état du catway peut être modifié. Le numéro et le type ne sont pas modifiables.
                    </div>

                    <form action="/catways/<%= catway.catwayNumber %>?_method=PUT" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Numéro du catway</label>
                            <input type="text" class="form-control" value="<%= catway.catwayNumber %>" disabled>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Type de catway</label>
                            <input type="text" class="form-control" value="<%= catway.catwayType %>" disabled>
                        </div>

                        <div class="mb-4">
                            <label for="catwayState" class="form-label">État du catway *</label>
                            <textarea class="form-control" id="catwayState" name="catwayState" 
                                      rows="3" required><%= catway.catwayState %></textarea>
                            <div class="form-text">Description de l'état actuel du catway</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Enregistrer les modifications
                            </button>
                            <a href="/catways/<%= catway.catwayNumber %>" class="btn btn-secondary">
                                <i class="bi bi-x-lg"></i> Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
