<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people"></i> Gestion des Utilisateurs</h2>
        <a href="/users/new" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Nouvel Utilisateur
        </a>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Liste des utilisateurs</span>
            <span class="badge bg-primary"><%= users.length %> utilisateur(s)</span>
        </div>
        <div class="card-body">
            <% if (users.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Nom d'utilisateur</th>
                                <th>Email</th>
                                <th>Inscrit le</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(u) { %>
                                <tr>
                                    <td>
                                        <i class="bi bi-person-circle"></i> <%= u.username %>
                                    </td>
                                    <td><%= u.email %></td>
                                    <td><%= new Date(u.createdAt).toLocaleDateString('fr-FR') %></td>
                                    <td>
                                        <a href="/users/<%= u.email %>" class="btn btn-sm btn-outline-primary btn-action" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/users/<%= u.email %>/edit" class="btn btn-sm btn-outline-warning btn-action" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <% if (u.email !== user.email) { %>
                                            <form action="/users/<%= u.email %>?_method=DELETE" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-action" 
                                                        data-confirm="Êtes-vous sûr de vouloir supprimer cet utilisateur ?" title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span class="badge bg-info">Vous</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center text-muted py-5">
                    <i class="bi bi-people display-1"></i>
                    <p class="mt-3">Aucun utilisateur enregistré</p>
                    <a href="/users/new" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Créer le premier utilisateur
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
